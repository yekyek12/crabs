APP_NAME="Crab Recognition AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crabs
DB_USERNAME=root
DB_PASSWORD=
FORCE_DEFAULT_SEEDER=false

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LOCAL_FILESYSTEM_ROOT=
PUBLIC_FILESYSTEM_ROOT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LOCATION_MAX_DEVICE_ACCURACY_METERS=100

AI_SERVICE_URL=http://127.0.0.1:9000
AI_SERVICE_TOKEN=
AI_REQUEST_TIMEOUT=5
AI_HEALTH_TIMEOUT=12
AI_RETRY_ENABLED=false
AI_CONFIDENCE_THRESHOLD=0.60
AI_HIGH_CONFIDENCE_THRESHOLD=0.85
AI_FAST_MODE_ENABLED=true
AI_FAST_PROVIDER_ORDER=gemini
AI_FAST_MIN_CONFIDENCE=0.60
AI_CONSENSUS_ENABLED=false
AI_REQUIRED_PROVIDER_COUNT=1
AI_MIN_PROVIDER_AGREEMENT=1
AI_ALLOW_SINGLE_PROVIDER_RESULT=true
AI_GLOBAL_DETECTION=true
AI_PROVIDER_ORDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
WISDOMGATE_API_KEY=

# FastAPI model adapter
AI_MODEL_PATH=
AI_MODEL_NAME="YOLO Crab Recognition Adapter"
AI_MODEL_VERSION=placeholder-1.0.0
AI_MODEL_CONFIDENCE_THRESHOLD=0.60
AI_IMAGE_MAX_EDGE=1280
AI_MODEL_CLASSES=
